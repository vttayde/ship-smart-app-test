{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
  "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@reduxjs/toolkit": ["./src/lib/rtk-shim.ts"],
      "next-auth/react": ["./src/stubs/next-auth-react.ts"],
      "next-auth": ["./src/stubs/next-auth-react.ts"],
      "react-redux": ["./src/stubs/react-redux.ts"],
  "@prisma/client": ["./src/stubs/prisma-client.ts"],
  "@radix-ui/react-slot": ["./src/stubs/radix-slot.tsx"],
  "class-variance-authority": ["./src/stubs/cva.ts"],
  "clsx": ["./src/stubs/clsx.ts"],
  "tailwind-merge": ["./src/stubs/tw-merge.ts" ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "prisma",
    "src/lib/ai-ml-utils.ts",
    "src/lib/auth.ts",
    "src/lib/google-maps.ts",
    "src/app/api/auth/[...nextauth]",
    "src/app/api/bookings",
    "src/app/api/couriers",
    "src/app/api/payments",
    "src/app/api/tracking",
    "src/app/api/ai"
  ]
}
